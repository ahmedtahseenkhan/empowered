# Base URL of the API (include the /api suffix). Production: https://emplearnings.com/api
VITE_API_URL=http://localhost:3000/api

# Cloudflare Turnstile site key (public). Leave empty to disable the widget; the server only
# enforces the check when TURNSTILE_SECRET_KEY is set, so set both together.
VITE_TURNSTILE_SITE_KEY=
