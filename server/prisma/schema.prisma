generator client {
  provider = "prisma-client-js"
}

model TutorTimeBlock {
  id       String       @id @default(uuid())
  tutor_id String
  tutor    TutorProfile @relation(fields: [tutor_id], references: [id])

  start_time DateTime
  end_time   DateTime
  reason     String?

  created_at DateTime @default(now())

  @@index([tutor_id])
  @@index([tutor_id, start_time])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ... existing generator/datasource ...

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum TutorTier {
  STANDARD
  PRO
  PREMIUM
}

enum MarketingVideoSubmissionStatus {
  DRAFT
  LINK_SUBMITTED
  EMAIL_REQUESTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LessonStatus {
  PENDING
  BOOKED
  COMPLETED
  CANCELLED
  MISSED
}

enum LessonBillingType {
  FREE_TRIAL
  FREE_INTRO // Standalone free introductory session (25 min)
  PAID
}

enum BookingFunding {
  CARD
  CREDITS
  FREE
}

enum BookingFrequency {
  ONCE
  WEEKLY
  TWICE_WEEKLY
  THRICE_WEEKLY
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          Role     @default(STUDENT)
  is_verified   Boolean  @default(false) // For email verification
  is_suspended  Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relationships
  student_profile StudentProfile?
  tutor_profile   TutorProfile?
  admin_profile   AdminProfile?

  password_reset_codes     PasswordResetCode[]
  email_verification_codes EmailVerificationCode[]

  support_tickets SupportTicket[]

  @@index([role])
}

model StudentProfile {
  id             String    @id @default(uuid())
  user_id        String    @unique
  user           User      @relation(fields: [user_id], references: [id])
  username       String
  profile_photo  String?
  learning_goals String?
  preferences    Json? // Stores: goal, frequency, budget, subjects
  date_of_birth  DateTime?
  grade_level    String?

  lessons          Lesson[]
  bookings         Booking[]
  reviews          Review[]
  subscriptions    Subscription[]
  mentor_status    StudentTutorStatus[]
  course_purchases CoursePurchase[]

  progress_notes ProgressNote[]

  // Stripe & Credits (Learning Credits wallet — 1 credit = 1 USD)
  stripe_customer_id    String?
  credits_balance       Int                  @default(0) // Available credits (purchased + promotional)
  promo_credits_balance Int                  @default(0) // Portion of credits_balance that is promotional (spent first)
  reserved_credits      Int                  @default(0) // Credits held for booked-but-not-completed sessions
  credit_history        CreditLedger[]
  reservations          SessionReservation[]
  mentor_earnings       MentorEarning[]
  disputes              SessionDispute[]

  homework_tasks HomeworkTask[]

  homework_submissions HomeworkSubmission[]

  @@index([stripe_customer_id])
}

model TutorProfile {
  id      String @id @default(uuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id])

  username         String
  profile_photo    String?
  tagline          String?
  about            String?
  hourly_rate      Int     @default(0)
  experience_years Int     @default(0)
  video_url        String?
  country          String?
  timezone         String  @default("UTC")
  key_strengths    String? // Stored as comma-separated or JSON string

  // Optional social links, shown on the public mentor profile.
  facebook_url  String?
  instagram_url String?
  linkedin_url  String?
  twitter_url   String?
  youtube_url   String?
  tiktok_url    String?
  website_url   String?

  is_verified    Boolean  @default(false) // Admin verification
  student_levels String[] @default([]) // ELEMENTARY_SCHOOL, MIDDLE_SCHOOL, HIGH_SCHOOL, COLLEGE_ADULT

  tier TutorTier @default(STANDARD) // Subscription plan

  // Denormalized fields
  rating         Float @default(0)
  review_count   Int   @default(0)
  total_students Int   @default(0)

  // Relationships
  education                   TutorEducation[]
  experience                  TutorExperience[]
  certifications              TutorCertification[]
  languages                   TutorLanguage[]
  categories                  TutorCategory[]
  availabilities              Availability[]
  free_session_availabilities FreeSessionAvailability[]
  free_session_enabled        Boolean                   @default(false)
  time_blocks                 TutorTimeBlock[]
  lessons                     Lesson[]
  bookings                    Booking[]
  google_calendar_connection  GoogleCalendarConnection?
  oauth_states                OAuthState[]
  courses                     Course[]
  reviews                     Review[]
  subscriptions               Subscription[]
  student_status              StudentTutorStatus[]
  external_reviews            TutorExternalReview[]

  // Stripe Connect & Subscription
  stripe_account_id      String? // Connect Account ID (for payouts)
  stripe_customer_id     String? // Stripe Customer ID — reused across checkouts to avoid duplicate customers
  stripe_subscription_id String? // ID of their subscription to the platform (Standard/Pro/Premium)
  subscription_status    String? // active, past_due, canceled
  subscription_end_date  DateTime? // When their current paid period ends
  has_used_trial         Boolean   @default(false) // Whether the tutor has already used their free trial
  is_beta                Boolean   @default(false) // Approved beta applicant
  is_founding_mentor     Boolean   @default(false) // Awarded when beta mentor completes their profile

  progress_notes ProgressNote[]
  homework_tasks HomeworkTask[]

  marketing_video_submission TutorMarketingVideoSubmission?
  whiteboards                Whiteboard[]
  wallet_earnings            MentorEarning[]
  wallet_disputes            SessionDispute[]

  @@index([stripe_subscription_id])
  @@index([stripe_customer_id])
  @@index([stripe_account_id])
  @@index([is_verified])
}

model Whiteboard {
  id         String       @id @default(uuid())
  tutor_id   String
  tutor      TutorProfile @relation(fields: [tutor_id], references: [id], onDelete: Cascade)
  lesson_id  String?      @unique
  lesson     Lesson?      @relation(fields: [lesson_id], references: [id], onDelete: SetNull)
  title      String       @default("Untitled Board")
  scene_data Json
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@index([tutor_id])
}

model AdminProfile {
  id             String   @id @default(uuid())
  user_id        String   @unique
  user           User     @relation(fields: [user_id], references: [id])
  username       String
  profile_photo  String?
  department     String?
  is_super_admin Boolean  @default(false)
  permissions    String[] @default([]) // module keys; ignored when is_super_admin
}

model TutorMarketingVideoSubmission {
  id       String       @id @default(uuid())
  tutor_id String       @unique
  tutor    TutorProfile @relation(fields: [tutor_id], references: [id], onDelete: Cascade)

  video_url    String?
  instructions String? @db.Text

  status MarketingVideoSubmissionStatus @default(DRAFT)

  link_submitted_at  DateTime?
  email_requested_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model GoogleCalendarConnection {
  id       String       @id @default(uuid())
  tutor_id String       @unique
  tutor    TutorProfile @relation(fields: [tutor_id], references: [id])

  calendar_id  String  @default("primary")
  timezone     String  @default("UTC")
  sync_enabled Boolean @default(true)

  access_token_enc  String?
  refresh_token_enc String?
  scope             String?
  token_type        String?
  expires_at        DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model PasswordResetCode {
  id      String @id @default(uuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  code_hash  String
  expires_at DateTime
  used_at    DateTime?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

model EmailVerificationCode {
  id      String @id @default(uuid())
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  code_hash  String
  expires_at DateTime
  used_at    DateTime?

  created_at DateTime @default(now())

  @@index([user_id])
  @@index([expires_at])
}

model OAuthState {
  state      String       @id
  tutor_id   String
  tutor      TutorProfile @relation(fields: [tutor_id], references: [id])
  expires_at DateTime
  created_at DateTime     @default(now())

  @@index([tutor_id])
  @@index([expires_at])
}

model EmailOutbox {
  id              String    @id @default(uuid())
  type            String
  to_email        String
  payload         Json
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  last_error      String?
  next_retry_at   DateTime?
  idempotency_key String?   @unique
  created_at      DateTime  @default(now())
  sent_at         DateTime?

  // Processor polls: status IN (...) AND (next_retry_at IS NULL OR <= now) ORDER BY created_at
  @@index([status, next_retry_at])
  @@index([status, created_at])
}

model TutorExternalReview {
  id           String       @id @default(uuid())
  tutor_id     String
  tutor        TutorProfile @relation(fields: [tutor_id], references: [id])
  platform     String // Google, Facebook, LinkedId, etc.
  reviewer     String
  rating       Int
  comment      String?
  external_url String?
  date         DateTime?
  is_verified  Boolean      @default(false)

  verification_status VerificationStatus @default(PENDING)
  rejection_reason    String?
  reviewed_at         DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tutor_id])
  @@index([verification_status])
}

// ... existing TutorEducation, TutorExperience, TutorCertification, TutorLanguage ...
// (Assuming these are unchanged, but I need to include them or use replace chunks carefully if I don't want to overwrite them. 
// Since I'm using replace_file_content with a large range, I must include EVERYTHING in the range.)

model TutorEducation {
  id             String       @id @default(uuid())
  tutor_id       String
  tutor          TutorProfile @relation(fields: [tutor_id], references: [id])
  institution    String
  degree         String
  field_of_study String
  year           Int

  @@index([tutor_id])
}

model TutorExperience {
  id          String       @id @default(uuid())
  tutor_id    String
  tutor       TutorProfile @relation(fields: [tutor_id], references: [id])
  role        String
  company     String
  start_year  Int
  end_year    Int?
  description String?

  @@index([tutor_id])
}

model TutorCertification {
  id          String       @id @default(uuid())
  tutor_id    String
  tutor       TutorProfile @relation(fields: [tutor_id], references: [id])
  name        String
  issuer      String
  year        Int
  image_url   String?
  is_verified Boolean      @default(false)

  verification_status VerificationStatus @default(PENDING)
  rejection_reason    String?
  reviewed_at         DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tutor_id])
  @@index([verification_status])
}

model TutorLanguage {
  id          String       @id @default(uuid())
  tutor_id    String
  tutor       TutorProfile @relation(fields: [tutor_id], references: [id])
  language    String
  proficiency String

  @@index([tutor_id])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  parent_id String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryHierarchy")

  tutors TutorCategory[]

  @@index([parent_id])
}

model TutorCategory {
  tutor_id    String
  tutor       TutorProfile @relation(fields: [tutor_id], references: [id])
  category_id String
  category    Category     @relation(fields: [category_id], references: [id])

  @@id([tutor_id, category_id])
  @@index([category_id])
}

model Booking {
  id         String         @id @default(uuid())
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])

  start_date DateTime
  end_date   DateTime // For recurring: when the block ends. For single: same as start (+duration)
  frequency  BookingFrequency @default(ONCE)

  /// Set when booking is created from Stripe Checkout; prevents duplicate processing (webhook + payment_intent + finalize).
  stripe_checkout_session_id String? @unique

  client_timezone String @default("UTC") // Student's IANA timezone at booking time

  /// How the sessions in this booking are paid: CARD (per-session Stripe checkout), CREDITS (Learning Credits wallet), FREE.
  funding BookingFunding @default(CARD)

  status     String // pending, active, completed, cancelled
  created_at DateTime @default(now())

  lessons          Lesson[]
  payment_schedule PaymentSchedule[]
  reservations     SessionReservation[]
  mentor_earnings  MentorEarning[]

  @@index([student_id])
  @@index([tutor_id])
  @@index([status])
}

model Lesson {
  id         String         @id @default(uuid())
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  booking_id String?
  booking    Booking?       @relation(fields: [booking_id], references: [id])

  start_time                DateTime
  end_time                  DateTime
  duration                  Int // in minutes
  status                    LessonStatus      @default(PENDING)
  billing_type              LessonBillingType @default(PAID)
  reschedule_count          Int               @default(0)
  meeting_link              String?
  google_calendar_event_id  String?           @unique
  google_calendar_html_link String?
  category                  String?

  completed_at  DateTime? // Set when the session is marked COMPLETED (auto or admin)
  cancel_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  review Review?

  progress_notes ProgressNote[]
  whiteboard     Whiteboard?
  reservation    SessionReservation?
  earning        MentorEarning?
  dispute        SessionDispute?

  @@index([tutor_id])
  @@index([student_id])
  @@index([booking_id])
  @@index([start_time])
  // Scheduler scans lessons by status within a start_time window (reminders, auto-cancel)
  @@index([status, start_time])
}

model PaymentSchedule {
  id         String  @id @default(uuid())
  booking_id String
  booking    Booking @relation(fields: [booking_id], references: [id])

  amount       Int
  due_date     DateTime
  status       String // pending, paid, failed
  stripe_pi_id String? // PaymentIntent ID

  created_at DateTime @default(now())

  @@index([booking_id])
  @@index([stripe_pi_id])
  // Scheduler/reconcile filters by status + due_date window
  @@index([status, due_date])
}

model Availability {
  id          String       @id @default(uuid())
  tutor_id    String
  tutor       TutorProfile @relation(fields: [tutor_id], references: [id])
  day_of_week Int // 0=Sunday
  start_time  String // "09:00"
  end_time    String // "17:00"

  @@index([tutor_id])
}

model FreeSessionAvailability {
  id          String       @id @default(uuid())
  tutor_id    String
  tutor       TutorProfile @relation(fields: [tutor_id], references: [id], onDelete: Cascade)
  day_of_week Int // 0=Sunday
  start_time  String // "09:00"
  end_time    String // "17:00"

  @@index([tutor_id])
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

model Course {
  id       String       @id @default(uuid())
  tutor_id String
  tutor    TutorProfile @relation(fields: [tutor_id], references: [id])

  // Basic Info
  title               String
  description         String? @db.Text
  duration            String? // e.g., "4 hours", "10 lessons"
  learning_objectives String? @db.Text
  target_audience     String?

  // Media
  thumbnail_url String? // Course thumbnail image URL
  category      String? // e.g., "Mathematics", "Science"

  // External Hosting
  course_url  String // YouTube, Vimeo, Google Drive link
  preview_url String? // Preview video/image URL

  // Pricing
  price Decimal @db.Decimal(10, 2)

  // Status
  status CourseStatus @default(DRAFT)

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  purchases CoursePurchase[]

  @@index([tutor_id])
  @@index([status])
}

model CoursePurchase {
  id         String         @id @default(uuid())
  course_id  String
  course     Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])

  // Payment
  amount_paid       Decimal @db.Decimal(10, 2)
  stripe_payment_id String?

  // Access
  purchased_at   DateTime @default(now())
  access_granted Boolean  @default(true)

  @@unique([course_id, student_id])
  @@index([student_id])
}

model Review {
  id         String         @id @default(uuid())
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  lesson_id  String?        @unique
  lesson     Lesson?        @relation(fields: [lesson_id], references: [id])

  rating      Int
  comment     String?
  is_verified Boolean  @default(false)
  created_at  DateTime @default(now())

  @@index([tutor_id])
  @@index([student_id])
}

model Subscription {
  id         String         @id @default(uuid())
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])

  stripe_sub_id      String
  status             String
  lessons_per_week   Int
  current_period_end DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([student_id])
  @@index([tutor_id])
  @@index([stripe_sub_id])
}

model StudentTutorStatus {
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])

  has_taken_trial Boolean @default(false)
  status          String

  @@id([student_id, tutor_id])
  @@index([tutor_id])
}

enum NoteVisibility {
  PRIVATE_TO_TUTOR
  SHARED_WITH_STUDENT
}

enum NoteAuthorRole {
  TUTOR
  STUDENT
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
  COMPLETED
}

model ProgressNote {
  id         String         @id @default(uuid())
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  lesson_id  String?
  lesson     Lesson?        @relation(fields: [lesson_id], references: [id])

  author_role NoteAuthorRole
  visibility  NoteVisibility @default(SHARED_WITH_STUDENT)
  body        String         @db.Text

  attachments Attachment[] @relation("NoteAttachments")

  created_at DateTime @default(now())

  @@index([tutor_id, student_id])
  @@index([lesson_id])
}

model HomeworkTask {
  id         String         @id @default(uuid())
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])

  title        String
  instructions String         @db.Text
  due_at       DateTime?
  status       HomeworkStatus @default(ASSIGNED)

  attachments Attachment[]         @relation("TaskAttachments")
  submissions HomeworkSubmission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tutor_id, student_id])
}

model HomeworkSubmission {
  id         String         @id @default(uuid())
  task_id    String
  task       HomeworkTask   @relation(fields: [task_id], references: [id], onDelete: Cascade)
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])

  message     String?      @db.Text
  attachments Attachment[] @relation("SubmissionAttachments")

  created_at DateTime @default(now())

  @@index([task_id, student_id])
}

model Attachment {
  id String @id @default(uuid())

  note_id       String?
  note          ProgressNote?       @relation("NoteAttachments", fields: [note_id], references: [id], onDelete: Cascade)
  task_id       String?
  task          HomeworkTask?       @relation("TaskAttachments", fields: [task_id], references: [id], onDelete: Cascade)
  submission_id String?
  submission    HomeworkSubmission? @relation("SubmissionAttachments", fields: [submission_id], references: [id], onDelete: Cascade)

  file_url  String
  file_name String
  mime_type String
  size      Int

  created_at DateTime @default(now())

  @@index([note_id])
  @@index([task_id])
  @@index([submission_id])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id              String  @id @default(uuid())
  user_id         String?
  user            User?   @relation(fields: [user_id], references: [id])
  submitter_name  String?
  submitter_email String?

  subject  String
  message  String         @db.Text
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  admin_notes String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  admin_replies AdminReply[]

  @@index([user_id])
  @@index([status])
}

model AdminReply {
  id        String        @id @default(uuid())
  ticket_id String
  ticket    SupportTicket @relation(fields: [ticket_id], references: [id])

  message String   @db.Text
  sent_at DateTime @default(now())

  @@index([ticket_id])
}

enum CreditTransactionType {
  PURCHASE // Credits bought with real money (Phase 2)
  PROMO_GRANT // Promotional / beta credits granted by admin
  MANUAL_ADJUSTMENT // Admin correction (positive or negative)
  RESERVE // Credits moved Available -> Reserved when sessions are booked
  UNRESERVE // Reserved credits returned to Available (cancellation within policy)
  RELEASE // Reserved credits released to the mentor after a completed session
  REVERSAL // Credits returned to student after an approved dispute
  CANCELLATION_REFUND // Legacy
  USAGE // Legacy
}

enum CreditSource {
  PURCHASED
  PROMOTIONAL
}

enum ReservationStatus {
  RESERVED
  RELEASED
  RETURNED
}

enum MentorEarningStatus {
  PENDING // Session completed; inside the settlement / risk window
  ON_HOLD // A dispute is open against this session
  AVAILABLE // Settlement window passed; payout-ready
  TRANSFERRED // Stripe transfer created (Phase 2)
  PAID // Paid out to the mentor's bank
  REVERSED // Dispute resolved in the student's favour; credits returned
}

enum DisputeStatus {
  OPEN
  RESOLVED_REFUNDED
  RESOLVED_RELEASED
}

/// Immutable, append-only record of every Learning Credit movement for a student.
model CreditLedger {
  id         String         @id @default(uuid())
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])

  amount        Int // Positive = credits added to Available, negative = removed from Available
  type          CreditTransactionType
  source        CreditSource? // Which pool the credits came from / went to
  balance_after Int? // Available balance after this entry (audit)
  description   String?
  metadata      Json? // booking_id, lesson_id, reservation_id, stripe ids, admin user id, etc.

  booking_id         String?
  lesson_id          String?
  reservation_id     String?
  created_by_user_id String? // Admin who performed a grant / adjustment

  created_at DateTime @default(now())

  @@index([student_id])
  @@index([student_id, created_at])
  @@index([lesson_id])
}

/// Credits held for one booked session. Available -> Reserved at booking; Released on completion; Returned on cancellation.
model SessionReservation {
  id         String         @id @default(uuid())
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  booking_id String
  booking    Booking        @relation(fields: [booking_id], references: [id])
  lesson_id  String         @unique
  lesson     Lesson         @relation(fields: [lesson_id], references: [id])

  credits       Int // Total credits reserved for this session (= mentor rate)
  promo_credits Int               @default(0) // Portion funded by promotional credits
  status        ReservationStatus @default(RESERVED)
  return_reason String?

  created_at  DateTime  @default(now())
  released_at DateTime?
  returned_at DateTime?

  @@index([student_id])
  @@index([booking_id])
  @@index([status])
}

/// A mentor's earning for one completed session. Amounts in cents (USD).
model MentorEarning {
  id             String         @id @default(uuid())
  tutor_id       String
  tutor          TutorProfile   @relation(fields: [tutor_id], references: [id])
  student_id     String
  student        StudentProfile @relation(fields: [student_id], references: [id])
  booking_id     String
  booking        Booking        @relation(fields: [booking_id], references: [id])
  lesson_id      String         @unique
  lesson         Lesson         @relation(fields: [lesson_id], references: [id])
  reservation_id String?

  gross_cents Int // Session price (credits * 100)
  fee_cents   Int // Payment & Settlement Fee
  net_cents   Int // What the mentor receives
  fee_percent Float // Fee rate applied at release time (e.g. 5)
  promo_cents Int   @default(0) // Portion of gross funded by promotional credits (platform liability)

  status       MentorEarningStatus @default(PENDING)
  available_at DateTime // When the settlement / risk window ends
  settled_at   DateTime? // When status moved to AVAILABLE
  paid_at      DateTime?
  reversed_at  DateTime?

  stripe_transfer_id String? // Phase 2
  stripe_payout_id   String? // Phase 2
  payout_note        String? // Phase 1 manual payout reference

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([tutor_id])
  @@index([tutor_id, status])
  @@index([student_id])
  @@index([status, available_at])
}

/// A student's complaint about a completed session, raised inside the settlement window.
model SessionDispute {
  id         String         @id @default(uuid())
  lesson_id  String         @unique
  lesson     Lesson         @relation(fields: [lesson_id], references: [id])
  student_id String
  student    StudentProfile @relation(fields: [student_id], references: [id])
  tutor_id   String
  tutor      TutorProfile   @relation(fields: [tutor_id], references: [id])

  reason              String
  status              DisputeStatus @default(OPEN)
  resolution_note     String?
  resolved_by_user_id String?

  created_at  DateTime  @default(now())
  resolved_at DateTime?

  @@index([status])
  @@index([student_id])
  @@index([tutor_id])
}

model StripeEvent {
  id         String   @id
  type       String
  data       Json
  processed  Boolean  @default(false)
  created_at DateTime @default(now())
}

model DemoBooking {
  id                 String   @id @default(uuid())
  full_name          String
  email              String
  phone              String?
  category_alignment String // Academic Tutoring | Life Coaching | Skill Development | All of the above
  experience_years   String // Just getting started | Less than 1 year | 1–3 years | 3+ years
  income_status      String // Yes recurring | Yes fluctuates | Not yet building | Planning to start soon
  looking_for        String   @db.Text // JSON array or comma-separated
  slot_start_time    DateTime
  slot_end_time      DateTime
  timezone           String   @default("America/Chicago")
  meeting_link       String? // Google Meet link (set for new bookings; optional for backwards compatibility so admin list works)
  created_at         DateTime @default(now())

  @@index([slot_start_time])
}

// Admin demo availability: configurable windows per day (e.g. Monday 9–11, 3–5). If empty, fallback to 9–17.
model AdminDemoAvailability {
  id          String @id @default(uuid())
  day_of_week Int // 0=Sunday, 1=Monday, ... 6=Saturday
  start_time  String // "09:00"
  end_time    String // "11:00"
}

// Admin demo time blocks: block specific times when admin is not available (like mentor blocks).
model AdminDemoTimeBlock {
  id         String   @id @default(uuid())
  start_time DateTime
  end_time   DateTime
  reason     String?
  created_at DateTime @default(now())

  @@index([start_time, end_time])
}

enum BetaApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model BetaApplication {
  id                  String                @id @default(uuid())
  full_name           String
  email               String
  phone_number        String
  service_description String                @db.Text
  category            String
  category_other      String?
  session_management  String[]
  has_active_clients  Boolean
  biggest_challenge   String                @db.Text
  profile_link        String?
  referral_source     String                @db.Text
  status              BetaApplicationStatus @default(PENDING)
  actioned_at         DateTime?
  created_at          DateTime              @default(now())

  @@index([email])
  @@index([status])
}
