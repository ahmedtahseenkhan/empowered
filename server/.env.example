
# Default Local PostgreSQL URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/empowered_learnings_v2?schema=public"

# JWT Secret
JWT_SECRET="dev-secret-key-change-in-prod"
PORT=3000

# Google Calendar Integration (Get credentials from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# Security
TOKEN_ENCRYPTION_KEY="random-secret-key-for-encryption"

# Stripe (subscription is billed annually: $300 / $540 / $1020)
STRIPE_SECRET_KEY="sk_..."
# Optional: annual Price IDs from Stripe. Run: npx ts-node scripts/create-annual-subscription-prices.ts
# STRIPE_PRICE_STANDARD_ANNUAL="price_..."
# STRIPE_PRICE_PRO_ANNUAL="price_..."
# STRIPE_PRICE_PREMIUM_ANNUAL="price_..."
