
# Default Local PostgreSQL URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/empowered_learnings_v2?schema=public"

# JWT secret. Production needs 32+ random characters (`openssl rand -hex 48`); the server
# refuses to start in production with this dev value.
JWT_SECRET="dev-only-jwt-secret-change-me"
PORT=3000
NODE_ENV=development

# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash).
# Production must list the main site AND the admin panel.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# CORS_ORIGINS="https://emplearnings.com,https://www.emplearnings.com,https://admin.emplearnings.com"
CLIENT_URL="http://localhost:5173"

# Cloudflare Turnstile (bot protection on signup, password reset, contact, demo and beta forms).
# Leave empty to disable the check; set the matching VITE_TURNSTILE_SITE_KEY in the client.
TURNSTILE_SECRET_KEY=""

# First admin account, used only by `npx prisma db seed`; remove the password afterwards.
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Google Calendar / Meet Integration (Get credentials from Google Cloud Console)
# Enable BOTH "Google Calendar API" and "Google Meet REST API" on the Cloud project.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
# Platform Google account (emplearnings@gmail.com). Owns EVERY Google Meet link the site
# hands out: demo calls and mentoring sessions. Session meetings are created with OPEN
# access so mentors and students join without knocking and without a host present.
# Obtain the token in the browser via /api/demo/oauth-start (see docs/DEMO_GOOGLE_SETUP.md).
# Those setup routes return 404 unless ENABLE_DEMO_OAUTH_SETUP=true; turn it off again afterwards.
# ENABLE_DEMO_OAUTH_SETUP=false
GOOGLE_DEMO_REFRESH_TOKEN=""
GOOGLE_DEMO_REDIRECT_URI="http://localhost:3000/api/demo/oauth-callback"
# Calendar on the platform account that receives the events (default: primary)
# GOOGLE_DEMO_CALENDAR_ID="primary"
# Access type for mentoring sessions. TRUSTED (default): the mentor is registered as
# co-host and the student as member, so both go straight in and the mentor admits anyone
# else who knocks; falls back to OPEN per session when the mentor cannot be registered.
# OPEN: anyone with the link joins (Meet shows "This call is open to anyone").
SESSION_MEET_ACCESS=TRUSTED
# Google address used by the admin status card to test co-host registration
# (defaults to ADMIN_EMAIL).
# MEET_COHOST_PROBE_EMAIL=

# Security: encrypts Google tokens and mentor bank/payout details. Generate with `openssl rand -hex 32`.
# Never change it once data is encrypted (existing values could no longer be decrypted).
TOKEN_ENCRYPTION_KEY="dev-only-encryption-key-change-me"

# Stripe (subscription is billed annually: $300 / $540 / $1020)
STRIPE_SECRET_KEY="sk_..."
# Optional: annual Price IDs from Stripe. Run: npx ts-node scripts/create-annual-subscription-prices.ts
# STRIPE_PRICE_STANDARD_ANNUAL="price_..."
# STRIPE_PRICE_PRO_ANNUAL="price_..."
# STRIPE_PRICE_PREMIUM_ANNUAL="price_..."

# ---- Email (SMTP) ----
# All system emails are sent through this mailbox. IMPORTANT: with Gmail, the visible
# From address is always the authenticated account (SMTP_USER) or a verified
# "Send mail as" alias in that Gmail — keep SMTP_FROM_EMAIL aligned with SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=emplearnings@gmail.com
SMTP_PASSWORD= # 16-character Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_FROM_NAME=EmpowerEd Learnings
SMTP_FROM_EMAIL=emplearnings@gmail.com

# ---- Learning Credits wallet (Phase 1) ----
# Master switch for the credits wallet (booking with credits, scheduler jobs)
WALLET_ENABLED=true
# Payment & Settlement Fee charged to mentors on completed-session earnings (percent)
WALLET_FEE_PERCENT=5
# Days a completed session's earnings stay PENDING (student review window) before becoming payout-ready
WALLET_SETTLEMENT_DAYS=7
# Weeks of sessions reserved per booking (client rule: four weekly sessions)
WALLET_WEEKS_PER_BOOKING=4
# Students may cancel a reserved session for a full credit return up to this many hours before it starts
WALLET_CANCEL_CUTOFF_HOURS=24
# Confirmation window: minutes after a session's end time before it is auto-marked COMPLETED
# (and the reserved credits approved for the mentor) when the learner neither clicked
# "Complete Session" nor reported a problem. Default 4320 = 72 hours.
WALLET_COMPLETION_GRACE_MINUTES=4320
# Hours after the session ends at which the learner gets the first and the final reminder
# to complete it (both must be smaller than the window above).
WALLET_CONFIRMATION_REMINDER_HOURS=24
WALLET_CONFIRMATION_FINAL_REMINDER_HOURS=48
# Minimum payout-ready balance (cents) before a monthly payout is made (used by Phase 2; shown to mentors now)
WALLET_PAYOUT_MINIMUM_CENTS=5000
# How often the wallet scheduler runs (ms)
WALLET_SCHEDULER_INTERVAL_MS=600000

# Demo call reminders (hours before the slot). Two emails are sent per demo:
# a day-before reminder and a same-day nudge.
DEMO_EARLY_REMINDER_HOURS=24
DEMO_REMINDER_HOURS=3

# ---- Learning Credits wallet (Phase 2) ----
# Day of the month the automatic mentor settlement runs (Stripe transfers)
WALLET_SETTLEMENT_DAY=1
# Credit purchase limits per checkout (1 credit = $1)
WALLET_PURCHASE_MIN=10
WALLET_PURCHASE_MAX=1000
# Preset packages shown on the wallet page (comma-separated credits)
WALLET_PURCHASE_PACKAGES=25,50,100,200
# Platform fee (percent) charged to the learner on top of each credit purchase. Shown as its
# own line at checkout; it is not added to the credit balance. Set 0 to disable.
WALLET_PURCHASE_FEE_PERCENT=10
# Signing secret of the SECOND Stripe webhook endpoint that listens to events on
# Connected accounts (payout.paid) — see Stripe dashboard > Developers > Webhooks
STRIPE_CONNECT_WEBHOOK_SECRET=

# ---- Custom sessions (mentor-scheduled, free: no payment or credits involved) ----
# Hours a student has to accept a scheduled session before the request expires (also capped at the start time)
CUSTOM_SESSION_OFFER_EXPIRY_HOURS=48
# Earliest a mentor may schedule, in hours from now
CUSTOM_SESSION_MIN_NOTICE_HOURS=2
# Allowed durations (minutes)
CUSTOM_SESSION_DURATIONS=30,45,60
# Unanswered session requests a mentor may have with the same student at once
CUSTOM_SESSION_MAX_OPEN_OFFERS=3
