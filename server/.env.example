
# Default Local PostgreSQL URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/empowered_learnings_v2?schema=public"

# JWT Secret
JWT_SECRET="dev-secret-key-change-in-prod"
PORT=3000

# Google Calendar Integration (Get credentials from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# Security
TOKEN_ENCRYPTION_KEY="random-secret-key-for-encryption"

# Stripe (subscription is billed annually: $300 / $540 / $1020)
STRIPE_SECRET_KEY="sk_..."
# Optional: annual Price IDs from Stripe. Run: npx ts-node scripts/create-annual-subscription-prices.ts
# STRIPE_PRICE_STANDARD_ANNUAL="price_..."
# STRIPE_PRICE_PRO_ANNUAL="price_..."
# STRIPE_PRICE_PREMIUM_ANNUAL="price_..."

# ---- Learning Credits wallet (Phase 1) ----
# Master switch for the credits wallet (booking with credits, scheduler jobs)
WALLET_ENABLED=true
# Payment & Settlement Fee charged to mentors on completed-session earnings (percent)
WALLET_FEE_PERCENT=5
# Days a completed session's earnings stay PENDING (student review window) before becoming payout-ready
WALLET_SETTLEMENT_DAYS=7
# Weeks of sessions reserved per booking (client rule: four weekly sessions)
WALLET_WEEKS_PER_BOOKING=4
# Students may cancel a reserved session for a full credit return up to this many hours before it starts
WALLET_CANCEL_CUTOFF_HOURS=24
# Minutes after a session's end time before it is auto-marked COMPLETED and credits are released
WALLET_COMPLETION_GRACE_MINUTES=30
# Minimum payout-ready balance (cents) before a monthly payout is made (used by Phase 2; shown to mentors now)
WALLET_PAYOUT_MINIMUM_CENTS=5000
# How often the wallet scheduler runs (ms)
WALLET_SCHEDULER_INTERVAL_MS=600000
